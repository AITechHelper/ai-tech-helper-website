# Copy this file to .env.local and fill in the values.
# .env.local is gitignored, so real secrets never get committed.

# GoHighLevel inbound-webhook URL for the footer "Get started" lead form.
# Create it in GHL: Automation → Workflows → Inbound Webhook trigger, then
# add a Create/Update Contact action mapping the incoming `email` field.
# Also set this in the Vercel project's Environment Variables for production.
GHL_WEBHOOK_URL=
